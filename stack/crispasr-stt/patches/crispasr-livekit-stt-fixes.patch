+// Send a pong frame echoing back a ping's payload (RFC 6455 5.5.3: "A Pong
+// frame sent in response to a Ping frame must have identical
+// 'Application data' as found in the message body of the Ping frame being
+// replied to"). Previously ping (0x09) frames were read off the socket
+// but never handled at all -- the file's own header comment even called
+// this out as an intentional limitation ("No ping/pong (connection drops
+// on timeout)"), but that's a real problem for any standards-compliant
+// client that does keepalive ping/pong (many do, including Python's
+// `websockets` library used in this evaluation's own test harness): with
+// no pong ever coming back, such a client eventually force-closes the
+// connection as unresponsive, killing any session that goes quiet for
+// longer than the client's ping timeout -- including natural pauses in a
+// real conversation. Found via a soak test: a persistent session that
+// worked correctly for several turns died with a WebSocket 1011
+// "keepalive ping timeout" every ~20-30s.
+static bool ws_send_pong(socket_t fd, const std::vector<uint8_t>& payload) {
+    std::vector<uint8_t> frame;
+    frame.push_back(0x8A); // FIN + pong opcode
+    if (payload.size() < 126) {
+        frame.push_back((uint8_t)payload.size());
+    } else if (payload.size() < 65536) {
+        frame.push_back(126);
+        frame.push_back((uint8_t)(payload.size() >> 8));
+        frame.push_back((uint8_t)(payload.size() & 0xFF));
+    } else {
+        frame.push_back(127);
+        for (int i = 7; i >= 0; i--)
+            frame.push_back((uint8_t)(payload.size() >> (8*i)));
+    }
+    frame.insert(frame.end(), payload.begin(), payload.end());
+    return send_all(fd, frame.data(), frame.size());
+}
