+// Escape a transcribed-text string for embedding in a JSON string literal.
+// Previously the two JSON-building call sites below embedded text_buf via
+// a raw snprintf %s with a comment claiming this was handled ("Escape
+// quotes in text for valid JSON") but no actual escaping -- any
+// transcribed text containing a literal '"' (quoted dialogue, common in
+// read-aloud literature) produced malformed JSON that broke client
+// parsers mid-stream, including on the final=true event, which then never
+// arrives correctly formed. Found via a multi-turn soak test hang in the
+// 2026-09-09 hearing-stack evaluation.
+//
+// A correct equivalent (crispasr_json_escape) already exists in
+// examples/cli/crispasr_output.cpp and is used properly there -- kept as
+// a self-contained duplicate here rather than pulling in that header,
+// since ws_stream.cpp is also compiled standalone into the leaner
+// examples/server `crispasr-server` target, which doesn't link
+// crispasr_output.cpp.
+static std::string json_escape(const char* s) {
+    std::string out;
+    out.reserve(strlen(s) + 16);
+    for (const char* p = s; *p; ++p) {
+        unsigned char c = (unsigned char)*p;
+        switch (c) {
+            case '"':  out += "\\\""; break;
+            case '\\': out += "\\\\"; break;
+            case '\b': out += "\\b";  break;
+            case '\f': out += "\\f";  break;
+            case '\n': out += "\\n";  break;
+            case '\r': out += "\\r";  break;
+            case '\t': out += "\\t";  break;
+            default:
+                if (c < 0x20) {
+                    char buf[8];
+                    snprintf(buf, sizeof(buf), "\\u%04x", c);
+                    out += buf;
+                } else {
+                    out += (char)c;
+                }
+        }
+    }
+    return out;
+}
