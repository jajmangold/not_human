# Volta resident MuseTalk configuration. Copy to .env and adjust only paths/GPU.
MUSE_TALK_IMAGE=musetalk:v100
MUSE_TALK_GPU_ID=4
MUSE_TALK_MODEL_CACHE=./models/musetalk
MUSE_TALK_IO_DIR=./runtime
MUSE_TALK_RESULTS_DIR=./runtime-data/musetalk-results
MUSE_TALK_TORCH_CACHE=./runtime-data/torch-cache

# Speed/quality switches from the archived Volta patch.
MUSE_USE_TAESD=1
MUSE_TAESD_ENCODE=0
MUSE_NO_PINGPONG=1
MUSE_PREP_WORKERS=10
MUSE_BLEND_WORKERS=20
MUSE_CACHE_AVATARS=1
MUSE_BATCH_SIZE=50
MUSE_AUDIO_WARMUP=1

# Kokoro ONNX assets (downloaded from onnx-community/Kokoro-82M-v1.0-ONNX).
KOKORO_MODEL_DIR=./models/kokoro-82m-v1.0-onnx
KOKORO_MODEL_FILE=model_q8f16.onnx
KOKORO_INTRA_OP_THREADS=12
KOKORO_INTER_OP_THREADS=1
KOKORO_CUSTOM_VOICE_DIR=./models/kokoro-custom-voices

# Optional KokoClone worker. Models are pulled lazily on the first clone/convert.
KOKOCLONE_ENABLED=1
KOKOCLONE_REVISION=dd6bd3acd3010dc223978839761db74957195f98
KOKOCLONE_MODEL_DIR=./models/kokoclone
KOKOCLONE_HF_CACHE_DIR=./models/kokoclone-huggingface
KOKOCLONE_TORCH_CACHE_DIR=./models/kokoclone-torch
MUSE_PLAYGROUND_RATE_LIMIT=60

# AdvancedLivePortrait generates a reusable idle-motion loop before MuseTalk.
ADVANCED_LIVE_PORTRAIT_ENABLED=1
ADVANCED_LIVE_PORTRAIT_GPU_ID=7
ADVANCED_LIVE_PORTRAIT_REVISION=3bba732915e22f18af0d221b9c5c282990181f1b
ADVANCED_LIVE_PORTRAIT_MODEL_DIR=./models/advanced-live-portrait
ADVANCED_LIVE_PORTRAIT_CACHE_DIR=./runtime-data/alp-cache
ADVANCED_LIVE_PORTRAIT_MAX_SOURCE_EDGE=512
ADVANCED_LIVE_PORTRAIT_FRAMES=28
ADVANCED_LIVE_PORTRAIT_PROFILE=semantic-bank-v13-blink-brow-fix

# Local web demo.
MUSE_DEMO_BIND=0.0.0.0
MUSE_DEMO_PORT=8092
MUSE_DEMO_MAX_UPLOAD_BYTES=10485760
MUSE_DEMO_MAX_PROMPT=8000
MUSE_DEMO_MAX_REPLY_TOKENS=512
MUSE_DEMO_JOB_TIMEOUT=300
MUSE_DEMO_SESSION_TTL=600
MUSE_DEMO_STREAM_BATCH_SIZE=4
MUSE_DEMO_STREAM_FPS=16
MUSE_MAX_CACHED_AVATARS=4
MUSE_MAX_POSE_FLOW_CACHE=64
MUSE_DEMO_START_RATE_LIMIT=6
MUSE_DEMO_FEEDBACK_RATE_LIMIT=900
MUSE_DEMO_MOTION_EDIT_RATE_LIMIT=240
MUSE_DEMO_MAX_RATE_KEYS=4096
# Optional bearer token for deployments exposed beyond the private tailnet.
# MUSE_DEMO_AUTH_TOKEN=set-in-workspace-env-only
MUSE_IDLE_CYCLE_FRAMES=64
MEDIAPIPE_FACE_LANDMARKER_DIR=./models/mediapipe-face-landmarker
MEDIAPIPE_FACE_LANDMARKER_SHA256=64184e229b263107bc2b804c6625db1341ff2bb731874b0bcc2fe6544e0bc9ff
UPPER_BODY_ENABLED=1
MEDIAPIPE_POSE_LANDMARKER_DIR=./models/mediapipe-pose-landmarker
MEDIAPIPE_POSE_LANDMARKER_SHA256=59929e1d1ee95287735ddd833b19cf4ac46d29bc7afddbbf6753c459690d574a
MINILM_MODEL_DIR=./models/minilm-l6-v2
MINILM_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
MINILM_MODEL_SHA256=6fd5d72fe4589f189f8ebc006442dbb529bb7ce38f8082112682524616046452
MINILM_TOKENIZER_SHA256=be50c3628f2bf5bb5e3a7f17b1f74611b2561a3a27eeab05e5aa30f411572037
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL=qwen27b
# LLM_API_KEY=only-if-the-gateway-is-later-protected
